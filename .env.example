# Copy to .env.local (ignored). Never commit actual credentials.
APP_ORIGIN=http://127.0.0.1:5189
PORT=4328

# Default: npm run setup provisions a private socket-only local PostgreSQL.
PGDATABASE=paperwake_local
PGADMINUSER=paperwake_admin
PGUSER=paperwake_app
DATABASE_ADMIN_ROLE=paperwake_admin
DATABASE_APP_ROLE=paperwake_app
# For an existing dedicated local database, also set PGHOST and PGPORT.
# PGHOST=/tmp
# PGPORT=5432

OPENAI_API_KEY=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
STORAGE_DRIVER=filesystem
FOLIO_BILLING_MOCK=false
FOLIO_AUTH_EMAIL_ENABLED=false
FOLIO_REQUIRE_EMAIL_VERIFICATION=false

# Hosted deployment uses a private schema, distinct restricted runtime roles,
# a separate migration identity, private Supabase storage and verified HTTPS.
# See docs/PAPERWAKE-DEPLOYMENT.md. Never use the local flags as a paid launch configuration.

# Optional independent signup gate for paid pilots. It works with live Stripe
# and preview disabled. Keep this unset for open registration; an empty/invalid
# configured value prevents startup. Use a private random 32–256-character code.
# PAPERWAKE_SIGNUP_INVITE_CODE=

# Optional private-pilot gate, independent of preview/test billing.
# PAPERWAKE_SIGNUP_INVITE_CODE=<random 32-256 characters without whitespace>
# Operator cost safeguards; these do not change customer page balances.
PAPERWAKE_AI_TRIAL_MONTHLY_USD=2
PAPERWAKE_AI_PAID_MONTHLY_USD=25
PAPERWAKE_AI_GLOBAL_MONTHLY_USD=100
